{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "gligabao",
  "colors": {
    "primary": "#0E7C66",
    "light": "#2EC4A0",
    "dark": "#0E7C66"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "getting-started/quickstart", "getting-started/how-it-works", "getting-started/configuration", "getting-started/database"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/datasets", "concepts/artifacts", "concepts/temporal", "concepts/identity", "concepts/sessions"]
          },
          {
            "group": "Guides",
            "pages": ["guides/chunking", "guides/images", "guides/timeseries", "guides/web-search", "guides/geo", "guides/mcp", "guides/cli", "guides/research", "guides/deep-research-agent", "guides/vectors"]
          },
          {
            "group": "Evals",
            "pages": ["evals/evals", "evals/experiments", "evals/training"]
          },
          {
            "group": "Training",
            "pages": [
              {
                "group": "Getting started",
                "pages": ["training/overview", "training/running", "training/modal"]
              },
              {
                "group": "Jobs and data",
                "pages": ["training/jobs", "training/datasets", "training/models", "training/trained-models", "training/deploying", "training/audit"]
              },
              {
                "group": "Internals",
                "pages": ["training/sidecar-api", "training/providers"]
              }
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Memory",
            "pages": ["api-reference/remember", "api-reference/query", "api-reference/graph"]
          },
          {
            "group": "Data",
            "pages": ["api-reference/ontologies", "api-reference/timeseries"]
          },
          {
            "group": "Service",
            "pages": ["api-reference/overview"]
          }
        ]
      },
      {
        "tab": "Embedding & ops",
        "groups": [
          {
            "group": "Embedding in Go",
            "pages": ["embedding/go-library", "embedding/hooks", "embedding/admin-extensions", "embedding/remember-manager", "embedding/pipeline"]
          },
          {
            "group": "Operations",
            "pages": ["operations/inferences", "operations/sidecar", "operations/pypi", "operations/versioning"]
          },
          {
            "group": "Appendix",
            "pages": ["appendix/not-included", "appendix/timeseries-design"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/deepblue-phoenix/gligabao"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/operations/evals", "destination": "/evals/evals" },
    { "source": "/operations/experiments", "destination": "/evals/experiments" },
    { "source": "/training/evals", "destination": "/evals/training" },
    { "source": "/training/exporting", "destination": "/training/deploying" },
    { "source": "/api-reference/recall", "destination": "/api-reference/query" }
  ],
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/deepblue-phoenix/gligabao"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/deepblue-phoenix/gligabao"
    }
  }
}
